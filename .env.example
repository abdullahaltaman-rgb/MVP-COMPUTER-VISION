# ── قاعدة البيانات (Postgres مُدارة) ──
DATABASE_URL="postgresql://user:pass@host:5432/abyad_vision?sslmode=require"

# ── أمان الجلسات ورموز الأجهزة ──
AUTH_SECRET="change-me-long-random-string"
CRON_SECRET="change-me-cron-secret"

# ── توقيع التقارير وبصمة التشغيل (Ed25519 PEM — يولَّد بـ:
#    node -e "const c=require('crypto');const k=c.generateKeyPairSync('ed25519');console.log(k.privateKey.export({type:'pkcs8',format:'pem'}))" )
SIGNING_PRIVATE_KEY_PEM=""

# ── مخزن الأدلة S3 المتوافق (منطقة سعودية) ──
S3_ENDPOINT="https://s3.me-central-1.amazonaws.com"
S3_REGION="me-central-1"
S3_BUCKET="abyad-vision-evidence"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"

# ── Gemini (الفحوصات الدلالية المجدولة + إعادة كشف التصحيح) ──
GEMINI_API_KEY=""
# batch = Gemini Batch API (النصف تكلفة، نتائج غير متزامنة) | sync = نداء مباشر
GEMINI_MODE="batch"

# ── إشعارات FCM (حساب خدمة Firebase بصيغة base64 لملف JSON) ──
FIREBASE_SERVICE_ACCOUNT_B64=""

# ── عام ──
APP_BASE_URL="https://abyad-vision.vercel.app"
