# ── قاعدة البيانات ──────────────────────────────────────────
# محليًا: ملف SQLite. للإنتاج على Turso: احذف/علّق DATABASE_URL
# واضبط TURSO_DATABASE_URL و TURSO_AUTH_TOKEN بدلًا منه.
DATABASE_URL="file:./dev.db"

# للإنتاج (Turso / libSQL) — تُستخدم تلقائيًا إن وُجدت:
# TURSO_DATABASE_URL="libsql://your-db.turso.io"
# TURSO_AUTH_TOKEN="ey..."

# ── محرك الكشف (Gemini) ─────────────────────────────────────
# إن تُرك فارغًا يعمل التطبيق بمزوّد المحاكاة (Mock) تلقائيًا.
GEMINI_API_KEY=""

# ── سرّ إعادة التعيين المجدولة (اختياري لـ Vercel Cron) ──────
CRON_SECRET=""
